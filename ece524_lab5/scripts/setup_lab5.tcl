# In Vivado 2023.2 Tcl console: source scripts/setup_lab5.tcl
set root [file normalize [file join [file dirname [info script]] ..]]
if {[current_project -quiet] eq ""} { open_project [file join $root ece524_lab5.xpr] }
set src [file join $root ece524_lab5.srcs sources_1 new]
set sim [file join $root ece524_lab5.srcs sim_1 new]
set_property target_language Verilog [current_project]
set_property simulator_language Mixed [current_project]
# Remove legacy handwritten VHDL from projects opened before migration.
foreach name {fir_pkg fir_parallel fir_serial fir_vendor main tb_fir} {
    set old [get_files -quiet */${name}.vhd]
    if {$old ne ""} { remove_files $old }
}
foreach name {fir_parallel fir_serial main} {
    set path [file join $src ${name}.v]
    if {[get_files -quiet $path] eq ""} { add_files -norecurse $path }
    set_property file_type Verilog [get_files $path]
}
set header [file join $src fir_defs.vh]
if {[get_files -quiet $header] eq ""} { add_files -norecurse $header }
set_property file_type {Verilog Header} [get_files $header]
set tb [file join $sim tb_fir.v]
if {[get_files -quiet $tb] eq ""} { add_files -fileset sim_1 -norecurse $tb }
set_property file_type Verilog [get_files $tb]
foreach fileset {sources_1 sim_1} {
    set dirs [get_property include_dirs [get_filesets $fileset]]
    if {[lsearch -exact $dirs $src] < 0} { lappend dirs $src }
    set_property include_dirs $dirs [get_filesets $fileset]
}
set_property top main [get_filesets sources_1]
set_property top tb_fir [get_filesets sim_1]
set_property generic {ARCH=0} [get_filesets sources_1]
set_property generic {ARCH=0 TEST_CASE=0 USE_DDS=1} [get_filesets sim_1]
set_property xsim.simulate.runtime 3ms [get_filesets sim_1]

set fh [open [file join $root coefficients fir_coefficients.txt] r]
set coefficients [regexp -all -inline -- {-?[0-9]+} [read $fh]]
close $fh
if {[llength $coefficients] != 21} { error "Expected 21 coefficients for order 20" }
if {[get_ips -quiet fir_compiler_0] eq ""} {
    create_ip -name fir_compiler -vendor xilinx.com -library ip -version 7.2 -module_name fir_compiler_0
}
set_property -dict [list CONFIG.CoefficientSource {Vector} \
    CONFIG.CoefficientVector [join $coefficients ,] \
    CONFIG.Filter_Type {Single_Rate} CONFIG.RateSpecification {Input_Sample_Period} \
    CONFIG.SamplePeriod {1} CONFIG.Clock_Frequency {5} \
    CONFIG.Filter_Architecture {Systolic_Multiply_Accumulate} \
    CONFIG.Coefficient_Width {16} CONFIG.Quantization {Integer_Coefficients} \
    CONFIG.Data_Width {16} CONFIG.Data_Fractional_Bits {0} \
    CONFIG.Output_Rounding_Mode {Full_Precision} CONFIG.Has_ARESETn {true}] [get_ips fir_compiler_0]
generate_target all [get_ips fir_compiler_0]
# Use the calculated precision, not the byte-padded AXI bus width, for sign extension.
set width [get_property CONFIG.Output_Width [get_ips fir_compiler_0]]
if {![string is integer -strict $width] || $width < 16 || $width > 37} {
    error "Unexpected FIR full-precision output width: $width"
}
set buswidth [expr {8 * (($width + 7) / 8)}]
set fh [open [file join $src fir_vendor.v] w]
puts $fh [string map [list @BUS_MSB@ [expr {$buswidth-1}] @MSB@ [expr {$width-1}]] {
`timescale 1ns/1ps
// Regenerated by scripts/setup_lab5.tcl using the IP's numerical width.
module fir_vendor (
    input wire clk, rst,
    input wire in_valid,
    output wire in_ready,
    input wire signed [15:0] x,
    output wire out_valid,
    output wire signed [36:0] y
);
    wire [@BUS_MSB@:0] data;
    wire ready_i;
    assign in_ready = ready_i & ~rst;
    fir_compiler_0 core (
        .aclk(clk), .aresetn(~rst),
        .s_axis_data_tvalid(in_valid), .s_axis_data_tready(ready_i),
        .s_axis_data_tdata(x), .m_axis_data_tvalid(out_valid),
        .m_axis_data_tdata(data)
    );
    assign y = $signed(data[@MSB@:0]);
endmodule
}]
close $fh
if {[get_files -quiet [file join $src fir_vendor.v]] eq ""} {
    add_files -norecurse [file join $src fir_vendor.v]
}
set_property file_type Verilog [get_files [file join $src fir_vendor.v]]

# System-parameter entry uses MHz for clock/output and Hz for resolution.
# SFDR=96 selects a 16-bit output. Verify the derived width before simulation.
foreach {name frequency} {dds_500k 0.5 dds_1600k 1.6} {
    if {[get_ips -quiet $name] eq ""} {
        create_ip -name dds_compiler -vendor xilinx.com -library ip -version 6.0 -module_name $name
    }
    set_property -dict [list CONFIG.Parameter_Entry {System_Parameters} \
        CONFIG.DDS_Clock_Rate {5} CONFIG.Spurious_Free_Dynamic_Range {96} \
        CONFIG.Frequency_Resolution {0.01} CONFIG.Phase_Increment {Fixed} \
        CONFIG.Output_Frequency1 $frequency CONFIG.Output_Selection {Sine} \
        CONFIG.Has_Phase_Out {false} CONFIG.Has_ARESETn {true}] [get_ips $name]
    generate_target all [get_ips $name]
    if {[get_property CONFIG.Output_Width [get_ips $name]] != 16} {
        error "DDS $name output is not 16 bits; inspect its configuration before continuing"
    }
    # DDS IP is testbench stimulus only. IP files use the USED_IN list;
    # the individual constraint-file flags are not supported on these files.
    set_property USED_IN {simulation} [get_files -of_objects [get_ips $name]]
}
update_compile_order -fileset sources_1
update_compile_order -fileset sim_1
puts "Lab 5 configured. FIR numerical width = $width, AXI bus width = $buswidth."
puts "Run: source scripts/run_simulations.tcl"
